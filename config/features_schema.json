    },
    "hospital_flag": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "病院・救急"
    },
    "welfare_flag": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "入所系福祉施設"
    },
    "public_flag": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "庁舎・防災拠点"
    },
    "alt_facility_dist_m": {
      "type": [
        "number",
        "null"
      ],
      "description": "同用途代替施設距離"
    },
    "data_versions": {
      "type": [
        "string",
        "null"
      ],
      "description": "使用データ版識別子"
    },
    "hazard_source_year": {
      "type": [
        "integer",
        "null"
      ],
      "description": "主ハザードデータの公表年（確信度減点用）"
    }
  },
  "additionalProperties": false
}